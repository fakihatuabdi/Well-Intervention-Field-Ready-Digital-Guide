# Copy this file to ".env" (same folder) and change the values.
# docker compose reads .env automatically. Never commit .env to git.

# --- Required: the first administrator account -------------------------------
# Created on first start only (when no admin exists yet). Change the password
# after the first sign-in via "My account".
ADMIN_EMAIL=admin@example.com
# At least 10 characters, with letters and numbers.
ADMIN_PASSWORD=

# --- Database password (only used inside Docker; empty = a default value) -----
POSTGRES_PASSWORD=

# --- Access ------------------------------------------------------------------
# true  = everyone must sign in (recommended for company use)
# false = anyone who can open the address may read (admin pages still need sign-in)
REQUIRE_LOGIN=true

# Let people request their own account. Requests wait for admin approval.
ALLOW_SIGNUP=false
# Only these e-mail domains may request an account (comma separated).
SIGNUP_EMAIL_DOMAIN=

# Sign idle users out after this many minutes.
SESSION_TIMEOUT_MINUTES=480

# --- Network -----------------------------------------------------------------
# Port on this computer/server.
APP_PORT=3000
# true only when users reach the app over HTTPS (e.g. behind a reverse proxy).
FORCE_SSL=false
# Optional: allowed host names / IPs, comma separated (empty = any).
APP_HOSTS=

# --- Features ----------------------------------------------------------------
# The AI chat bot page (off: nothing is sent outside the network).
CHAT_BOT_ENABLED=false
# Add example case studies and notices on first start (demo only).
SEED_DEMO_CONTENT=false

# --- Advanced ----------------------------------------------------------------
# Leave empty: a random secret is generated and kept in the app-storage volume.
SECRET_KEY_BASE=
