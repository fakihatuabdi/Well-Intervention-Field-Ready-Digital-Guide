<div class="fade-in w-full max-w-md mx-auto mt-16">
  <div class="bg-white rounded-2xl shadow-lg p-8 border border-slate-100">
    <h1 class="text-2xl font-bold text-slate-800 mb-1">Request an account</h1>
    <p class="text-sm text-slate-500 mb-6">
      An administrator must approve your request before you can sign in.
      <% if AppSettings.signup_email_domains.any? %>
        Use your company e-mail (<%= AppSettings.signup_email_domains.map { |d| "@#{d}" }.join(", ") %>).
      <% end %>
    </p>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-4", data: { turbo: false } }) do |f| %>
      <%= render "admin/shared/errors", record: resource %>
      <div>
        <%= f.label :name, "Full name", class: admin_label_class %>
        <%= f.text_field :name, autofocus: true, maxlength: 100, required: true, class: admin_input_class %>
      </div>
      <div>
        <%= f.label :email, "E-mail", class: admin_label_class %>
        <%= f.email_field :email, autocomplete: "email", required: true, class: admin_input_class %>
      </div>
      <div>
        <%= f.label :password, class: admin_label_class %>
        <%= f.password_field :password, autocomplete: "new-password", required: true, class: admin_input_class %>
        <p class="text-xs text-slate-500 mt-1">At least <%= @minimum_password_length || 10 %> characters, with letters and numbers.</p>
      </div>
      <div>
        <%= f.label :password_confirmation, "Repeat password", class: admin_label_class %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true, class: admin_input_class %>
      </div>
      <%= f.submit "Send request", class: AdminHelper::PRIMARY_BUTTON + " w-full py-3" %>
    <% end %>

    <p class="mt-6 text-sm text-slate-600">Already have an account? <%= link_to "Sign in", new_user_session_path, class: "text-sky-700 font-semibold hover:underline" %></p>
  </div>
</div>
