<div class="fade-in w-full max-w-6xl mx-auto">
  <div class="mb-8">
    <%= link_to handbook_path, class: "text-sky-600 hover:text-sky-800 mb-4 inline-flex items-center gap-2 transition-all duration-300" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      Back to Handbook
    <% end %>
    <h1 class="text-3xl md:text-4xl font-bold text-slate-800 mb-2 mt-4">General Knowledge</h1>
    <p class="text-slate-600">Fundamental concepts and best practices for well intervention operations</p>
  </div>

  <div class="mb-6 rounded-xl border border-sky-200 bg-sky-50 p-4 text-sm text-sky-900">
    <p class="font-semibold">Materi umum oil &amp; gas</p>
    <p class="mt-1">Bagian ini berisi pengetahuan dasar well intervention yang berlaku umum di industri migas. Praktik khusus lapangan ada di bagian Zona Rokan Operation.</p>
  </div>

  <%= render "handbook/article_grid", articles: @articles, accent: "sky" %>
</div>
