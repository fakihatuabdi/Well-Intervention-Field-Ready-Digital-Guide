<div class="fade-in w-full max-w-6xl mx-auto">
  <%= render "admin/shared/nav" %>
  <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
    <h1 class="text-3xl font-bold text-slate-800">Articles</h1>
    <%= link_to "New article", new_admin_article_path, class: AdminHelper::PRIMARY_BUTTON %>
  </div>

  <%= form_with url: admin_articles_path, method: :get, class: "flex flex-wrap gap-2 mb-4" do |f| %>
    <%= f.search_field :q, value: params[:q], placeholder: "Search title or text", class: admin_input_class + " max-w-xs" %>
    <%= f.select :category, [["All sections", ""]] + Article::CATEGORY_LABELS.invert.to_a, { selected: params[:category] }, class: admin_input_class + " max-w-xs" %>
    <%= f.submit "Filter", class: AdminHelper::SECONDARY_BUTTON %>
  <% end %>

  <div class="bg-white rounded-xl shadow border border-slate-100 overflow-x-auto">
    <table class="min-w-full text-sm">
      <thead>
        <tr class="text-left text-slate-500 border-b">
          <th class="p-3">Title</th>
          <th class="p-3">Section</th>
          <th class="p-3">Order</th>
          <th class="p-3">Status</th>
          <th class="p-3">Updated</th>
          <th class="p-3"></th>
        </tr>
      </thead>
      <tbody>
        <% @articles.each do |article| %>
          <tr class="border-b border-slate-100">
            <td class="p-3 font-medium text-slate-800"><%= article.title %></td>
            <td class="p-3"><%= article.category_label %></td>
            <td class="p-3"><%= article.position %></td>
            <td class="p-3"><%= article.published? ? status_badge("Published", :green) : status_badge("Hidden", :slate) %></td>
            <td class="p-3 text-slate-500 whitespace-nowrap"><%= l(article.updated_at, format: :short) %></td>
            <td class="p-3 whitespace-nowrap">
              <%= link_to "Edit", edit_admin_article_path(article), class: "text-sky-700 hover:underline mr-3" %>
              <% if article.published? %>
                <%= link_to "View", article_path(article), class: "text-slate-600 hover:underline" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <div class="mt-4"><%= paginate @articles %></div>
</div>
