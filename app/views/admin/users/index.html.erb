<div class="fade-in w-full max-w-6xl mx-auto">
  <%= render "admin/shared/nav" %>
  <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
    <div>
      <h1 class="text-3xl font-bold text-slate-800">Users</h1>
      <p class="text-slate-600">
        <strong>Admin</strong> can edit content and manage users. <strong>Pengguna</strong> can only read.
        <% if AppSettings.allow_signup? %>
          Self sign-up is <strong>on</strong><%= AppSettings.signup_email_domains.any? ? " for #{AppSettings.signup_email_domains.map { |d| "@#{d}" }.join(', ')}" : "" %>; new requests wait here for approval.
        <% else %>
          Self sign-up is <strong>off</strong>; only admins create accounts.
        <% end %>
      </p>
    </div>
    <%= link_to "New user", new_admin_user_path, class: AdminHelper::PRIMARY_BUTTON %>
  </div>

  <div class="flex flex-wrap gap-2 mb-4 text-sm">
    <% [["All", nil], ["Waiting approval", "pending"], ["Active", "active"], ["Disabled", "disabled"]].each do |label, status| %>
      <%= link_to label, admin_users_path(status: status), class: "px-3 py-1 rounded-full #{params[:status].to_s == status.to_s ? 'bg-sky-600 text-white' : 'bg-white border border-slate-200 text-slate-700'}" %>
    <% end %>
  </div>

  <div class="bg-white rounded-xl shadow border border-slate-100 overflow-x-auto">
    <table class="min-w-full text-sm">
      <thead>
        <tr class="text-left text-slate-500 border-b">
          <th class="p-3">Name / e-mail</th><th class="p-3">Role</th><th class="p-3">Status</th><th class="p-3">Last sign-in</th><th class="p-3"></th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr class="border-b border-slate-100">
            <td class="p-3">
              <div class="font-medium text-slate-800"><%= user.name.presence || "-" %></div>
              <div class="text-slate-500"><%= user.email %></div>
            </td>
            <td class="p-3"><%= user.admin? ? status_badge("Admin", :sky) : "Pengguna" %></td>
            <td class="p-3"><%= user_status_badge(user) %></td>
            <td class="p-3 text-slate-500 whitespace-nowrap"><%= user.last_sign_in_at ? l(user.last_sign_in_at, format: :short) : "Never" %></td>
            <td class="p-3 whitespace-nowrap">
              <% if user.pending? %>
                <%= button_to "Approve", approve_admin_user_path(user), method: :patch, form_class: "inline", class: "text-green-700 font-semibold hover:underline mr-3" %>
              <% end %>
              <% if user.access_locked? %>
                <%= button_to "Unlock", unlock_admin_user_path(user), method: :patch, form_class: "inline", class: "text-amber-700 font-semibold hover:underline mr-3" %>
              <% end %>
              <%= link_to "Edit", edit_admin_user_path(user), class: "text-sky-700 hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <div class="mt-4"><%= paginate @users %></div>
</div>
