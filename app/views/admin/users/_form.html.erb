<%= form_with model: [:admin, user], class: "space-y-5" do |f| %>
  <%= render "admin/shared/errors", record: user %>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <%= f.label :name, class: admin_label_class %>
      <%= f.text_field :name, maxlength: 100, class: admin_input_class %>
    </div>
    <div>
      <%= f.label :email, "E-mail (used to sign in)", class: admin_label_class %>
      <%= f.email_field :email, required: true, autocomplete: "off", class: admin_input_class %>
    </div>
    <div>
      <%= f.label :role, class: admin_label_class %>
      <%= f.select :role, User::ROLE_LABELS.invert.to_a, {}, class: admin_input_class %>
    </div>
    <div>
      <%= f.label :status, class: admin_label_class %>
      <%= f.select :status, User::STATUS_LABELS.invert.to_a, {}, class: admin_input_class %>
    </div>
    <div>
      <%= f.label :password, user.new_record? ? "Password" : "New password (leave empty to keep the current one)", class: admin_label_class %>
      <%= f.password_field :password, autocomplete: "new-password", required: user.new_record?, class: admin_input_class %>
      <p class="text-xs text-slate-500 mt-1">At least 10 characters, with letters and numbers.</p>
    </div>
    <div>
      <%= f.label :password_confirmation, "Repeat password", class: admin_label_class %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: admin_input_class %>
    </div>
  </div>
  <div class="flex gap-3">
    <%= f.submit "Save user", class: AdminHelper::PRIMARY_BUTTON %>
    <%= link_to "Back to list", admin_users_path, class: AdminHelper::SECONDARY_BUTTON %>
  </div>
<% end %>
