<div class="fade-in w-full max-w-5xl mx-auto">
  <%= render "admin/shared/nav" %>
  <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
    <div>
      <h1 class="text-3xl font-bold text-slate-800">Case studies</h1>
      <p class="text-slate-600">"Case Studies &amp; Lessons Learned" on the home page.</p>
    </div>
    <%= link_to "New case study", new_admin_case_study_path, class: AdminHelper::PRIMARY_BUTTON %>
  </div>
  <div class="bg-white rounded-xl shadow border border-slate-100 overflow-x-auto">
    <table class="min-w-full text-sm">
      <thead><tr class="text-left text-slate-500 border-b"><th class="p-3">Title</th><th class="p-3">Status</th><th class="p-3">Created</th><th class="p-3"></th></tr></thead>
      <tbody>
        <% @case_studies.each do |case_study| %>
          <tr class="border-b border-slate-100">
            <td class="p-3 font-medium text-slate-800"><%= case_study.title %></td>
            <td class="p-3"><%= case_study.published? ? status_badge("Published", :green) : status_badge("Hidden", :slate) %></td>
            <td class="p-3 whitespace-nowrap"><%= l(case_study.created_at, format: :short) %></td>
            <td class="p-3 whitespace-nowrap">
              <%= link_to "Edit", edit_admin_case_study_path(case_study), class: "text-sky-700 hover:underline mr-3" %>
              <%= button_to "Delete", admin_case_study_path(case_study), method: :delete, form_class: "inline", class: "text-red-700 hover:underline", data: { turbo_confirm: "Delete this case study?" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <div class="mt-4"><%= paginate @case_studies %></div>
</div>
