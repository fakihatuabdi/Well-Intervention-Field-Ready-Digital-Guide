#!/bin/bash -e
# Prepare the database before starting the web server.
# db:prepare creates/migrates the schema; seeds only add missing starter content
# and load the handbook articles. A seed problem must not keep the site down,
# so it is reported and the server still starts.
if [ "${1}" == "bundle" ] && [ "${3}" == "puma" ]; then
  ./bin/rails db:prepare
  ./bin/rails db:seed || echo "WARNING: db:seed failed (see log above). The app starts anyway; run 'bin/rails db:seed' after fixing it."
fi

exec "${@}"
